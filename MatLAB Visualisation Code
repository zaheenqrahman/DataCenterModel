      % - 
      device_inventory(2).psu_links(1) = struct('psu_id', "PSU-1", 'feed', "A", 'connected_pdu_port', "PDU-A-01:C13-02", 'link_status', "Run");
      % - 
      device_inventory(2).psu_links(2) = struct('psu_id', "PSU-2", 'feed', "B", 'connected_pdu_port', "PDU-B-01:C13-02", 'link_status', "Run");

  % - 
    device_inventory(3).id = "SW-03";
    device_inventory(3).hostname = "cat9300-sw03";
    device_inventory(3).type = "C9300-24H";
    % psu_links:
      % - 
      device_inventory(3).psu_links(1) = struct('psu_id', "PSU-1", 'feed', "A", 'connected_pdu_port', "PDU-A-01:C13-03", 'link_status', "Run");
      % - 
      device_inventory(3).psu_links(2) = struct('psu_id', "PSU-2", 'feed', "B", 'connected_pdu_port', "PDU-B-01:C13-03", 'link_status', "Run");

  % - 
    device_inventory(4).id = "SW-04";
    device_inventory(4).hostname = "cat9300-sw04";
    device_inventory(4).type = "C9300-24H";
    % psu_links:
      % - 
      device_inventory(4).psu_links(1) = struct('psu_id', "PSU-1", 'feed', "A", 'connected_pdu_port', "PDU-A-01:C13-04", 'link_status', "Run");
      % - 
      device_inventory(4).psu_links(2) = struct('psu_id', "PSU-2", 'feed', "B", 'connected_pdu_port', "PDU-B-01:C13-04", 'link_status', "Run");

  % - 
    device_inventory(5).id = "SW-05";
    device_inventory(5).hostname = "cat9300-sw05";
    device_inventory(5).type = "C9300-24H";
    % psu_links:
      % - 
      device_inventory(5).psu_links(1) = struct('psu_id', "PSU-1", 'feed', "A", 'connected_pdu_port', "PDU-A-01:C13-05", 'link_status', "Run");
      % - 
      device_inventory(5).psu_links(2) = struct('psu_id', "PSU-2", 'feed', "B", 'connected_pdu_port', "PDU-B-01:C13-05", 'link_status', "Run");

% visualization & graphing based on exact parsed data above


% extract data for charting
switch_names = [device_inventory.id];
p_typical = device_types.C9300_24H.power_consumption.typical_power_w;
p_max_no_poe = device_types.C9300_24H.power_consumption.max_switch_power_w;
p_poe = device_types.C9300_24H.power_consumption.poe_available_w;
num_devices = infrastructure.total_stack_devices;

power_matrix = repmat([p_typical, p_max_no_poe, p_max_no_poe + p_poe], num_devices, 1);

% graphing
figure('Name', 'Catalyst 9300 Power Metrics');
bar(categorical(switch_names), power_matrix, 'grouped');
title('Power Budget Distribution per Switch');
xlabel('Device ID');
ylabel('Power (Watts)');
legend({'Typical Output (W)', 'Max Switch Allocation (No PoE)', 'Total Max Limit (Switch + PoE)'}, 'Location', 'northwest');
grid on;
