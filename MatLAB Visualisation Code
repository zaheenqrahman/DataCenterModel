    device_inventory(1).id = "SW-01";
    device_inventory(1).hostname = "cat9300-sw01";
    device_inventory(1).type = "C9300-24H";
    % psu_links:
      % - 
      device_inventory(1).psu_links(1) = struct('psu_id', "PSU-1", 'feed', "A", 'connected_pdu_port', "PDU-A-01:C13-01", 'link_status', "Run");
      % - 
      device_inventory(1).psu_links(2) = struct('psu_id', "PSU-2", 'feed', "B", 'connected_pdu_port', "PDU-B-01:C13-01", 'link_status', "Run");

  % - 
    device_inventory(2).id = "SW-02";
