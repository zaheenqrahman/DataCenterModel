devices:
  - {name: core1, role: core}
  - {name: core2, role: core} # core layer is high capacity switch, two of them for failure situations
  - {name: acc1,  role: access} # access layer is a switch in data center model
  - {name: acc2,  role: access}  
  - {name: srv1,  role: server} 
  - {name: srv2,  role: server}

network_links:
  - [acc1, core1]
  - [acc1, core2]       # backup second network link
  - [acc2, core1] 
  - [acc2, core2]
  - [srv1, acc1]
  - [srv2, acc2]

power:
  feeds:
    A: {capacity_kw: 8.0}
    B: {capacity_kw: 8.0}
  psu_links:
    - {device: core1, psu: A, feed: A}
    - {device: core2, psu: A, feed: A} 
    - {device: acc1, psu: B, feed: B}
    - {device: acc2, psu: A, feed: A}
    - {device: srv1, psu: A, feed: A} # both servers map to same PSU and feed
    - {device: srv2, psu: A, feed: A}
